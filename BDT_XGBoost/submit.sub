# Executable script
executable            = run_bdt.sh

# Output files
output                = condor/output/xgb.$(ClusterId).$(ProcId).out
error                 = condor/error/xgb.$(ClusterId).$(ProcId).err
log                   = condor/log/xgb.$(ClusterId).log

# Resource requirements
# request_cpus           = 4
 request_memory         = 32000MB
# request_disk           = 10GB

# Job duration
+JobFlavour            = "longlunch"


# Automatically transfer input/output files
should_transfer_files  = YES
when_to_transfer_output = ON_EXIT

# Job notifications
notification           = Always
notify_user = anuj.raghav@cern.ch

# Inherit the submission environment
# (getenv = True)

# Submit jobs
queue


# Available CERN HTCondor Job Flavours
# espresso     = 20 minutes
# microcentury = 1 hour
# longlunch    = 2 hours
# workday      = 8 hours
# tomorrow     = 1 day
# testmatch    = 3 days
# nextweek     = 1 week